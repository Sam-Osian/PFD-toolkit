{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfdtoolkit.org/schemas/issue-occurrence-v1.json",
  "title": "PFD Toolkit issue extraction response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["issues"],
  "properties": {
    "issues": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_statement_original",
          "canonical_issue",
          "source_section",
          "source_span",
          "failure_mode",
          "issue_object_text",
          "subject_domain",
          "process_stage",
          "system_mechanism",
          "setting",
          "system_level",
          "responsible_entity_text",
          "affected_population",
          "claim_status",
          "temporality"
        ],
        "properties": {
          "issue_statement_original": {"type": "string", "maxLength": 300},
          "canonical_issue": {"type": "string", "maxLength": 240},
          "source_section": {
            "enum": ["circumstances", "concerns", "both", "unclear"]
          },
          "source_span": {"type": "string", "maxLength": 700},
          "failure_mode": {
            "enum": [
              "missing", "delayed", "incomplete", "incorrect", "ambiguous",
              "inconsistent", "not_reviewed", "not_communicated", "not_acted_upon",
              "not_escalated", "not_documented", "not_monitored", "not_assessed",
              "not_followed_up", "unavailable", "insufficient", "non_compliant",
              "unsafe_design", "other", "unclear"
            ]
          },
          "issue_object_text": {"type": "string", "maxLength": 120},
          "subject_domain": {
            "enum": [
              "clinical_care", "medication", "mental_health", "communication_information",
              "staffing_capacity", "training_competence", "equipment_infrastructure",
              "technology_interoperability", "emergency_response", "social_care_housing",
              "safeguarding", "governance_learning", "justice_custody", "roads_transport",
              "workplace_public_safety", "other", "unclear"
            ]
          },
          "process_stage": {
            "enum": [
              "assessment", "diagnosis", "planning", "referral", "admission", "treatment",
              "prescribing", "monitoring", "escalation", "handover", "transfer", "discharge",
              "follow_up", "emergency_response", "incident_investigation",
              "organisational_learning", "maintenance", "other", "unclear"
            ]
          },
          "system_mechanism": {
            "enum": [
              "policy_process", "staffing_capacity", "training_competence",
              "communication_coordination", "documentation_information",
              "technology_interoperability", "equipment_infrastructure",
              "governance_accountability", "commissioning_service_provision",
              "environmental_design", "other", "unclear"
            ]
          },
          "setting": {
            "enum": [
              "acute_hospital", "mental_health_inpatient", "community_healthcare",
              "primary_care", "ambulance_emergency", "care_home", "domiciliary_care",
              "hospice_palliative", "prison_custody", "police", "education",
              "workplace", "road_transport", "domestic_home", "public_space",
              "multi_setting", "other", "unclear"
            ]
          },
          "system_level": {
            "enum": [
              "individual_practice", "team", "service", "organisation",
              "inter_organisational", "regional", "national", "unclear"
            ]
          },
          "responsible_entity_text": {"type": "string", "maxLength": 160},
          "affected_population": {
            "enum": [
              "patient", "resident", "child_young_person", "family_carer", "staff",
              "road_user", "person_in_custody", "public", "multiple", "other", "unclear"
            ]
          },
          "claim_status": {
            "enum": [
              "observed_failure", "reported_concern", "ongoing_risk",
              "potential_future_risk", "recommended_improvement", "unclear"
            ]
          },
          "temporality": {
            "enum": ["historical", "ongoing", "prospective", "mixed", "unclear"]
          }
        }
      }
    }
  }
}
